{
  "name": "arkham-wikipedia-crawler",
  "version": "1.0.0",
  "private": true,
  "description": "Crawl Arkham House bibliography from Wikipedia and build a cover gallery viewer",
  "scripts": {
    "crawl": "node scripts/index.js",
    "crawl:local": "node scripts/index.js --local",
    "crawl:mycroft": "node scripts/index.js --mycroft-only",
    "crawl:mycroft:local": "node scripts/index.js --mycroft-only --local",
    "crawl:test": "node scripts/index.js --limit 5",
    "sync-collection": "node scripts/index.js --sync-collection",
    "sync-publication-dates": "node scripts/index.js --sync-publication-dates --local",
    "sync-authors": "node scripts/index.js --sync-authors",
    "sync-descriptions": "node scripts/index.js --sync-descriptions",
    "sync-descriptions:local": "node scripts/index.js --sync-descriptions --local",
    "sync-goodreads": "node scripts/index.js --sync-goodreads",
    "sync-goodreads:dry-run": "node scripts/index.js --sync-goodreads --dry-run",
    "sync-goodreads:missing": "node scripts/index.js --sync-goodreads-missing",
    "sync-goodreads:missing:dry-run": "node scripts/index.js --sync-goodreads-missing --dry-run",
    "import-goodreads-shelf": "node scripts/index.js --import-goodreads-shelf",
    "reconcile-covers": "node scripts/index.js --reconcile-covers",
    "dedupe-book-ids": "node scripts/index.js --dedupe-book-ids",
    "compact-edits": "node scripts/index.js --compact-edits",
    "fill-covers": "node scripts/index.js --fill-covers",
    "fill-covers:dry-run": "node scripts/index.js --fill-covers --dry-run",
    "bundle-viewer": "node scripts/bundle-viewer-js.js",
    "build": "node build.js",
    "serve": "node server.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2"
  }
}
