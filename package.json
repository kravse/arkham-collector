{
  "name": "arkham-wikipedia-crawler",
  "version": "1.0.0",
  "private": true,
  "description": "Crawl Arkham House bibliography from Wikipedia and build a cover gallery viewer",
  "scripts": {
    "crawl": "node my_script.js",
    "crawl:local": "node my_script.js --local",
    "crawl:test": "node my_script.js --limit 5",
    "sync-collection": "node my_script.js --sync-collection",
    "reconcile-covers": "node my_script.js --reconcile-covers",
    "fill-covers": "node my_script.js --fill-covers",
    "fill-covers:dry-run": "node my_script.js --fill-covers --dry-run",
    "build": "node build.js",
    "serve": "node server.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2"
  }
}
